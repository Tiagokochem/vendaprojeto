# App
PANEL_SECRET=change-me-to-a-long-random-string
PANEL_PORT=8088
APP_ENV=development

# Conta demo (opcional, só local). Sem DEMO_SEED=true o boot não cria usuário.
# DEMO_SEED=true
# DEMO_EMAIL=seu@email.local
# DEMO_PASSWORD=senha-forte

# Postgres
POSTGRES_USER=venda
POSTGRES_PASSWORD=venda_dev_pass
POSTGRES_DB=vendaprojeto
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# OpenAI (Hermes LLM + RAG, opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evolution (QR + send real quando preenchido)
EVOLUTION_BASE_URL=http://127.0.0.1:8081
AUTHENTICATION_API_KEY=

# Webhook HMAC opcional (X-Hub-Signature-256)
WEBHOOK_HMAC_SECRET=

# Apify (captura real; sem token a captura falha, sem seed)
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places

# URL pública do painel (VPS). Obrigatória para Mercado Pago (back_urls / webhook)
PUBLIC_BASE_URL=http://127.0.0.1:8088

# Mercado Pago (Checkout Pro R$ 10 + doação)
# Crie em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Opcional: link pronto de doação (alternativa à preferência)
MERCADOPAGO_DONATION_URL=
